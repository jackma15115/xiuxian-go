# ==========================================
# 修仙 AI Web 游戏 - 环境变量配置
# ==========================================

# 网页服务端口 (默认 8080)
PORT=8080

# ------------------------------------------
# 1. 主 AI API 配置
# ------------------------------------------
# 支持 OpenAI / DeepSeek / Gemini / OneAPI / NewAPI / Ollama 等兼容接口
# 例如: https://api.openai.com/v1 或 https://api.deepseek.com/v1
URL=https://api.openai.com/v1
APIKEY=your_api_key_here
MODEL=gpt-4o-mini
# 接口协议类型: openai (默认) 或 gemini
API_TYPE=openai

# ------------------------------------------
# 2. 流式 / 非流式强制策略 (可选)
# ------------------------------------------
# 规则：未配置时默认按原生规则自适应（根据客户端请求是否含 stream=true 决定）
# 可选值：
#   true  或 stream - 强制所有请求走流式（若客户端为普通请求，服务端在后台接收流式并组装为完整响应返回）
#   false 或 sync   - 强制所有请求走非流式（同步获取完整回复）
#   留空 (默认)      - 按客户端请求的原生规则处理
# FORCE_STREAM=true

# ------------------------------------------
# 3. 额外 AI API 配置 (可选)
# ------------------------------------------
# 用于世界推演、人物图谱、手机助手等扩展功能
# 规则：若未配置以下环境变量，系统默认自动走主 API 配置
# EXTRA_URL=https://api.openai.com/v1
# EXTRA_APIKEY=your_extra_api_key
# EXTRA_MODEL=gpt-4o-mini
# EXTRA_API_TYPE=openai
# EXTRA_FORCE_STREAM=true

# ------------------------------------------
# 4. Embedding 向量接口配置 (可选)
# ------------------------------------------
# 规则：若未配置 EMBEDDING_MODEL 且未配置 EMBEDDING_URL，系统默认自动走浏览器本地计算 (Transformers.js / 关键词)
# 若配置了 EMBEDDING_MODEL（例如: text-embedding-3-small），系统将启用服务端向量接口：
#   - 若未配置 EMBEDDING_URL，自动回退复用主 API 的 URL
#   - 若未配置 EMBEDDING_APIKEY，自动回退复用主 API 的 APIKEY
# 若使用独立的向量模型提供商，可同时配置 EMBEDDING_URL 与 EMBEDDING_APIKEY
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_URL=https://api.openai.com/v1
# EMBEDDING_APIKEY=your_embedding_api_key
